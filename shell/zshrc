# --- Machine-local overrides (not tracked in dotfiles) ---
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# --- Prompt ---
autoload -U colors && colors
bindkey -v

function zle-keymap-select zle-line-init {
  case $KEYMAP in
    vicmd)         vi_mode="%K{red}%F{white}%B N %b%f%k" ;;
    main|viins|*)  vi_mode="%K{green}%F{white}%B I %b%f%k" ;;
  esac
  zle reset-prompt
}
zle -N zle-keymap-select
zle -N zle-line-init

setopt PROMPT_SUBST
PROMPT='%F{cyan}%n%f@%F{yellow}%m%f %F{blue}%~%f ${vi_mode} %# '

# --- Editor ---
# Prefer nvim, fall back to vim, then vi — so a machine without nvim still
# gets a working editor instead of a dangling reference. The vim alias only
# exists when nvim does, so real vim keeps working otherwise.
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
  export VISUAL=nvim
  alias vim=nvim
elif command -v vim >/dev/null 2>&1; then
  export EDITOR=vim
  export VISUAL=vim
else
  export EDITOR=vi
  export VISUAL=vi
fi

# Vi mode
bindkey -v

# Visual mode opens full editor
autoload -U edit-command-line
zle -N edit-command-line
bindkey -M vicmd 'v' edit-command-line
bindkey '^Xe' edit-command-line

# --- Aliases ---
alias n="clear&&ls"
alias ls='ls --color=auto'
alias yolo='claude --dangerously-skip-permissions'

# Obsidian vault location — override per-machine by setting OBSIDIAN_VAULT
# (e.g. in ~/.zshrc.local) before this file's defaults kick in.
if [[ -z "$OBSIDIAN_VAULT" ]]; then
  if [[ "$OSTYPE" == darwin* ]]; then
    OBSIDIAN_VAULT="$HOME/ObsidianVault"
  else
    OBSIDIAN_VAULT="$HOME/vaults/PersonalVault"
  fi
fi
alias claudeprojects='cd "$OBSIDIAN_VAULT/ClaudeProjects" && claude'

# OCDump aliases
alias journaldump="{ ocdump daily --start=2024-01-01; ocdump tagged context; }"
alias journaldumpshort="{ ocdump daily --start=2025-04-01; ocdump tagged context; }"

# --- Shell options ---
setopt noauto_cd

# r shell builtin gets in the way of running the r language interpreter
disable r

# History
HISTSIZE=1000000
SAVEHIST=1000000
HISTFILE=~/.zsh_history
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY

# --- Tool integrations ---

# fzf — prefer the binary's own shell integration (`fzf --zsh`, fzf >= 0.48),
# which works the same whether fzf came from apt, brew, or the git installer.
# Fall back to the ~/.fzf.zsh file the git installer writes for older fzf.
if command -v fzf >/dev/null 2>&1 && fzf --zsh >/dev/null 2>&1; then
  eval "$(fzf --zsh)"
elif [ -f ~/.fzf.zsh ]; then
  source ~/.fzf.zsh
fi

# iTerm2 (macOS only)
if [[ "$OSTYPE" == darwin* ]]; then
  test -e "$HOME/.iterm2_shell_integration.zsh" && source "$HOME/.iterm2_shell_integration.zsh"
fi

# Fix JLCPCB center files from KiCad
# https://jlcpcb.com/help/article/how-to-generate-the-bom-and-centroid-file-from-kicad
alias fixPlacementFileForJLC="gsed -i '1s/Ref/Designator/;1s/PosX/Mid X/;1s/PosY/Mid Y/;1s/Rot/Rotation/;1s/Side/Layer/'"

# worktreetools (wt) — added by Claude
case ":$PATH:" in *":$HOME/.cargo/bin:"*) ;; *) export PATH="$HOME/.cargo/bin:$PATH" ;; esac
command -v worktreetools >/dev/null 2>&1 && eval "$(worktreetools shell-init zsh)"
