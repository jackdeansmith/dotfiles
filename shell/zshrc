# --- Sorin-Style Prompt (no Prezto) ---

# Load colors and set VI mode keybindings
autoload -U colors && colors
bindkey -v

# Keymap-change handler for vi mode prompt indicator
function zle-keymap-select () {
  case $KEYMAP in
    viins|main)
      prompt_chevrons="%B%F{red}❯%F{yellow}❯%F{green}❯%f%b"
      ;;
    vicmd)
      prompt_chevrons="%B%F{green}❮%F{yellow}❮%F{red}❮%f%b"
      ;;
    *)
      prompt_chevrons="%B%F{blue}❯%f%b"
      ;;
  esac
  zle reset-prompt
}
zle -N zle-keymap-select

function zle-line-init () {
  zle-keymap-select
}
zle -N zle-line-init

setopt PROMPT_SUBST
PROMPT='${SSH_TTY:+"%F{cyan}%n%f@%F{yellow}%m%f "}%F{blue}%~%f%(!.%F{red}# %f.) $prompt_chevrons '

# --- Editor ---
export EDITOR=nvim
export VISUAL=nvim

# Vi mode
bindkey -v

# Visual mode opens full editor
autoload -U edit-command-line
zle -N edit-command-line
bindkey -M vicmd 'v' edit-command-line
bindkey '^Xe' edit-command-line

# --- Aliases ---
alias n="clear&&ls"
alias vim=nvim
alias ls='ls --color=auto'

# macOS-specific aliases
if [[ "$OSTYPE" == darwin* ]]; then
  alias claudeprojects='cd ~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/ObsidianVault/ClaudeProjects && claude'
fi

# OCDump aliases
alias journaldump="{ ocdump daily --start=2024-01-01; ocdump tagged context; }"
alias journaldumpshort="{ ocdump daily --start=2025-04-01; ocdump tagged context; }"

# --- Shell options ---
setopt noauto_cd

# Add current directory to path
export PATH=$PATH:.

# r shell builtin gets in the way of running the r language interpreter
disable r

# --- Tool integrations ---

# chruby (guard for portability)
if [[ -s /opt/homebrew/opt/chruby/share/chruby/chruby.sh ]]; then
  source /opt/homebrew/opt/chruby/share/chruby/chruby.sh
  chruby ruby-3.1.3
fi

# fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# iTerm2 (macOS only)
if [[ "$OSTYPE" == darwin* ]]; then
  test -e "$HOME/.iterm2_shell_integration.zsh" && source "$HOME/.iterm2_shell_integration.zsh"
fi

# Cargo
export PATH="$PATH:$HOME/.cargo/bin"
